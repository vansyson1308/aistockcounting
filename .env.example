# Local development environment
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/stockdb

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tray-images

# Routing
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80
NEXT_PUBLIC_API_BASE=http://localhost/api/v1
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Runtime
MOCK_MODE=true
CONFIDENCE_THRESHOLD=0.25
MAX_IMAGE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=30
INFERENCE_CONCURRENCY_LIMIT=2

# Optional auth flag (default off for MVP)
ENABLE_SIMPLE_AUTH=false
SIMPLE_AUTH_TOKEN=

# Model selection
MODEL_PATH=./models/best.onnx
MODEL_PT_PATH=./models/best.pt
MODEL_ONNX_PATH=./models/best.onnx

# Staging image defaults
BACKEND_IMAGE=ghcr.io/<owner>/aistockcounting-backend:v0.1.0
FRONTEND_IMAGE=ghcr.io/<owner>/aistockcounting-frontend:v0.1.0
