# Production-lite template (copy to .env on server)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockdb
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/stockdb
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=tray-images
CORS_ORIGINS=https://your-domain
NEXT_PUBLIC_API_BASE=https://your-domain/api/v1
MOCK_MODE=false
MODEL_PT_PATH=models/vj_items/v0001/best.pt
MODEL_ONNX_PATH=
RATE_LIMIT_PER_MINUTE=60
BACKEND_IMAGE=ghcr.io/<owner>/aistockcounting-backend:v0.1.0
FRONTEND_IMAGE=ghcr.io/<owner>/aistockcounting-frontend:v0.1.0
